{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-operation": "database.deploy",
  "x-object-kind": "database",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engineVersion",
    "instanceClass",
    "storageGiB"
  ],
  "properties": {
    "engine": {
      "type": "string",
      "enum": [
        "postgres"
      ],
      "default": "postgres"
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1
    },
    "instanceClass": {
      "type": "string",
      "minLength": 1
    },
    "storageGiB": {
      "type": "integer",
      "minimum": 1
    }
  }
}

