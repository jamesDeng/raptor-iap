{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "raptor-ax-bridge",
        "namespace": "ax-system"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "raptor-ax-bridge-state",
        "namespace": "ax-system"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "raptor-ax-bridge",
        "namespace": "ax-system"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "raptor-ax-bridge"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "raptor-ax-bridge"
            }
          },
          "spec": {
            "serviceAccountName": "raptor-ax-bridge",
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "fsGroup": 65532
            },
            "containers": [
              {
                "name": "bridge",
                "image": "localhost:5001/raptor-ax-bridge@sha256:1677bcc7050626dcb19c2a6f348755e476a6d4b8e33dfaf161819033c2bd6855",
                "env": [
                  {
                    "name": "AX_PI_IMAGE",
                    "value": "localhost:5001/ax-pi@sha256:1656169754d6ccaa937d2b30f1c5fa72130e0904e879c85ca41250dc91b6047e"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8443,
                    "hostPort": 8443,
                    "hostIP": "10.70.1.180"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "state",
                    "mountPath": "/state",
                    "readOnly": false
                  },
                  {
                    "name": "tls",
                    "mountPath": "/tls",
                    "readOnly": true
                  },
                  {
                    "name": "ate-token",
                    "mountPath": "/var/run/secrets/ateapi",
                    "readOnly": true
                  },
                  {
                    "name": "ca",
                    "mountPath": "/run/servicedns-ca",
                    "readOnly": true
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 8443
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "state",
                "persistentVolumeClaim": {
                  "claimName": "raptor-ax-bridge-state"
                }
              },
              {
                "name": "tls",
                "secret": {
                  "secretName": "raptor-ax-bridge-tls",
                  "defaultMode": 288
                }
              },
              {
                "name": "ate-token",
                "projected": {
                  "sources": [
                    {
                      "serviceAccountToken": {
                        "audience": "api.ate-system.svc",
                        "expirationSeconds": 7200,
                        "path": "token"
                      }
                    }
                  ]
                }
              },
              {
                "name": "ca",
                "projected": {
                  "sources": [
                    {
                      "clusterTrustBundle": {
                        "labelSelector": {
                          "matchLabels": {
                            "podcert.ate.dev/canarying": "live"
                          }
                        },
                        "path": "trust-bundle.pem",
                        "signerName": "servicedns.podcert.ate.dev/identity"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "ax-control-private",
        "namespace": "ax-system"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "ax-server"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app": "raptor-ax-bridge"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8080
              }
            ]
          }
        ]
      }
    }
  ]
}
