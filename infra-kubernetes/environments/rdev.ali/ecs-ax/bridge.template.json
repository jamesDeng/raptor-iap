{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "raptor-ax-bridge",
        "namespace": "ax-system"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "raptor-ax-bridge-state",
        "namespace": "ax-system"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "raptor-ax-bridge",
        "namespace": "ax-system"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "raptor-ax-bridge"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "raptor-ax-bridge"
            }
          },
          "spec": {
            "serviceAccountName": "raptor-ax-bridge",
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "fsGroup": 65532
            },
            "containers": [
              {
                "name": "bridge",
                "image": "${BRIDGE_IMAGE}",
                "env": [
                  {
                    "name": "AX_PI_IMAGE",
                    "value": "${PI_IMAGE}"
                  },
                  {
                    "name": "RUNTIME_EGRESS_HOSTS",
                    "value": "[\"auth.openai.com\", \"chatgpt.com\", \"api.openai.com\", \"api.rdev.raptor-iap.top\", \"infra-api.raptor-iap.top\"]"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8443,
                    "hostPort": 8443,
                    "hostIP": "${PRIVATE_IP}"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "state",
                    "mountPath": "/state",
                    "readOnly": false
                  },
                  {
                    "name": "tls",
                    "mountPath": "/tls",
                    "readOnly": true
                  },
                  {
                    "name": "ate-token",
                    "mountPath": "/var/run/secrets/ateapi",
                    "readOnly": true
                  },
                  {
                    "name": "ca",
                    "mountPath": "/run/servicedns-ca",
                    "readOnly": true
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 8443
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "state",
                "persistentVolumeClaim": {
                  "claimName": "raptor-ax-bridge-state"
                }
              },
              {
                "name": "tls",
                "secret": {
                  "secretName": "raptor-ax-bridge-tls",
                  "defaultMode": 288
                }
              },
              {
                "name": "ate-token",
                "projected": {
                  "sources": [
                    {
                      "serviceAccountToken": {
                        "audience": "api.ate-system.svc",
                        "expirationSeconds": 7200,
                        "path": "token"
                      }
                    }
                  ]
                }
              },
              {
                "name": "ca",
                "projected": {
                  "sources": [
                    {
                      "clusterTrustBundle": {
                        "labelSelector": {
                          "matchLabels": {
                            "podcert.ate.dev/canarying": "live"
                          }
                        },
                        "path": "trust-bundle.pem",
                        "signerName": "servicedns.podcert.ate.dev/identity"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "ax-control-private",
        "namespace": "ax-system"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "ax-server"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app": "raptor-ax-bridge"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8080
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "guest-router-private",
        "namespace": "ate-system"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "atenet-router"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "ax-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app": "raptor-ax-bridge"
                  }
                }
              },
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "ax-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "ax-server"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "ax-worker-private",
        "namespace": "ax-workers"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "ate.dev/worker-pool": "ax"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "ate-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app": "atenet-router"
                  }
                }
              },
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "ate-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app": "ate-controller"
                  }
                }
              },
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "ate-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app": "ate-api-server"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
