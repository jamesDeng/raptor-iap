+func TestPreferredWorkerIP(t *testing.T) {
+	for _, tc := range []struct {
+		ips  []string
+		want string
+	}{
+		{nil, ""}, {[]string{"invalid"}, ""}, {[]string{"fd00::1"}, "fd00::1"},
+		{[]string{"fd00::1", "10.76.0.2"}, "10.76.0.2"},
+		{[]string{"invalid", "10.76.0.3"}, "10.76.0.3"},
+	} {
+		if got := preferredWorkerIP(tc.ips); got != tc.want {
+			t.Errorf("%v got %q want %q", tc.ips, got, tc.want)
+		}
+	}
+}
+
+func TestBuildActorTemplateDataResumeContract(t *testing.T) {
+	tmpl := BuildActorTemplate("poc", "pi", "registry/pi@sha256:abc", nil, nil, "s3://ate-snapshots/poc")
+	if len(tmpl.Containers) != 1 || tmpl.Containers[0].GetWakeupProbe().GetHttpGet().GetPath() != "/readyz" {
+		t.Fatal("missing guest wakeup probe")
+	}
+	snapshot := tmpl.GetSnapshotConfig()
+	if snapshot.GetOnPause() != ateapipb.SnapshotContentScope_SNAPSHOT_CONTENT_SCOPE_DATA || snapshot.GetOnCommit() != ateapipb.SnapshotContentScope_SNAPSHOT_CONTENT_SCOPE_DATA {
+		t.Fatal("Pi must preserve durable data rather than process memory")
+	}
+	if snapshot.GetStorageLocation() != "s3://ate-snapshots/poc" {
+		t.Fatal("snapshot target changed")
+	}
+	if len(tmpl.Volumes) != 1 || tmpl.Volumes[0].GetDurableDir() == nil {
+		t.Fatal("workspace is not durable")
+	}
+}
+
+func TestBuildActorTemplateDedicatedWorkerPool(t *testing.T) {
+	tmpl := BuildActorTemplate("poc", "pi", "registry/pi", nil, nil, "gs://ate-snapshots/ax")
+	if tmpl.GetWorkerSelector().GetMatchLabels()["workload"] != "ax" {
+		t.Fatal("AX actor can select an unrelated worker pool")
+	}
+}
