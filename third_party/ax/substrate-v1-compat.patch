+// Prefer IPv4 for existing single-stack gateways, with an IPv6 fallback.
+func preferredWorkerIP(ips []string) string {
+	var fallback string
+	for _, value := range ips {
+		ip, err := netip.ParseAddr(value)
+		if err != nil {
+			endpoint, endpointErr := netip.ParseAddrPort(value)
+			if endpointErr != nil {
+				continue
+			}
+			ip = endpoint.Addr()
+		}
+		if ip.Is4() {
+			return value
+		}
+		if fallback == "" {
+			fallback = value
+		}
+	}
+	return fallback
+}
