+func TestSyncer_PodIPChanged_ViaInformer(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	ns, podName, poolName := "ns-ip-restart", "worker-ip-restart", "pool1"
+	api := newFakeControl()
+	fakeK8s := setupSyncerTest(t, ctx, api, workerPool(ns, poolName, "gvisor", map[string]string{"workload": "ax"}))
+	oldPod := workerPod(ns, podName, poolName, testPodUID, "10.0.0.7")
+	oldPod.Status.ContainerStatuses = []corev1.ContainerStatus{{Name: ateomContainer}}
+	if _, err := fakeK8s.CoreV1().Pods(ns).Create(ctx, oldPod, metav1.CreateOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	waitForWorker(t, ctx, api, testPodUID, func(w *ateapipb.Worker) bool { return w != nil })
+
+	changed := oldPod.DeepCopy()
+	changed.Status.PodIP = "10.0.0.8"
+	changed.Status.PodIPs = []corev1.PodIP{{IP: "10.0.0.8"}}
+	changed.Status.ContainerStatuses[0].RestartCount = 1
+	if _, err := fakeK8s.CoreV1().Pods(ns).UpdateStatus(ctx, changed, metav1.UpdateOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	waitForWorker(t, ctx, api, testPodUID, func(w *ateapipb.Worker) bool { return w == nil })
+	if _, err := fakeK8s.CoreV1().Pods(ns).Get(ctx, podName, metav1.GetOptions{}); !apierrors.IsNotFound(err) {
+		t.Errorf("old pod remains after reconcile: %v", err)
+	}
+
+	replacement := workerPod(ns, podName, poolName, otherPodUID, "10.0.0.8")
+	if _, err := fakeK8s.CoreV1().Pods(ns).Create(ctx, replacement, metav1.CreateOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	waitForWorker(t, ctx, api, otherPodUID, func(w *ateapipb.Worker) bool { return w != nil })
+	if got := api.get(otherPodUID).GetIps(); !slices.Equal(got, []string{"10.0.0.8"}) {
+		t.Errorf("replacement IPs = %v, want 10.0.0.8", got)
+	}
+}
