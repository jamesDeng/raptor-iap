+func TestSyncer_PodIPChanged_LeavesOtherPoolsAlone(t *testing.T) {
+	ctx := context.Background()
+	ns, name, pool := "ate-demo-counter", "counter-worker", "counter"
+	api := newFakeControl()
+	s, pods, _ := setupReconcileTest(t, api, workerPool(ns, pool, "gvisor", nil))
+	key := seedPod(t, pods, workerPod(ns, name, pool, testPodUID, "10.0.0.7"))
+	mustReconcile(t, ctx, s, key)
+	if err := pods.Update(workerPod(ns, name, pool, testPodUID, "10.0.0.8")); err != nil {
+		t.Fatal(err)
+	}
+	mustReconcile(t, ctx, s, key)
+	if got := api.get(testPodUID).GetStatus().GetState(); got != ateapipb.WorkerState_WORKER_STATE_ACTIVE {
+		t.Errorf("worker state = %v, want ACTIVE", got)
+	}
+}
