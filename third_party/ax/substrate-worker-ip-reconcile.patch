+func TestDrainIdleWorker_WaitsForAssignmentRelease(t *testing.T) {
+	ctx := context.Background()
+	svc, persistence := newWorkerAPIService(t)
+	seedAPIWorker(t, ctx, persistence, validWorker(apiWorkerName))
+	const actor = "actor-uid-1"
+	before := assignAPIWorker(t, ctx, persistence, apiWorkerName, actor)
+	req := &ateapipb.DrainWorkerRequest{Worker: workerRef(apiWorkerName)}
+	if _, err := svc.DrainIdleWorker(ctx, req); status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("DrainIdleWorker with a binding = %v, want FailedPrecondition", err)
+	}
+	stillActive, err := persistence.GetWorker(ctx, apiWorkerName)
+	if err != nil || !proto.Equal(stillActive, before) {
+		t.Fatalf("busy drain changed worker: %v, %v", stillActive, err)
+	}
+	host, err := persistence.FindWorkerHostingActor(ctx, actor)
+	if err != nil || host != apiWorkerName {
+		t.Fatalf("actor host = %q, %v, want original worker", host, err)
+	}
+	if _, err := persistence.ReleaseActorFromWorker(ctx, apiWorkerName, actor); err != nil {
+		t.Fatal(err)
+	}
+	drained, err := svc.DrainIdleWorker(ctx, req)
+	if err != nil || drained.GetStatus().GetState() != ateapipb.WorkerState_WORKER_STATE_DRAINING ||
+		drained.GetStatus().GetAllocated().GetActors() != 0 {
+		t.Fatalf("DrainIdleWorker after release = %v, %v, want idle and draining", drained, err)
+	}
+}
