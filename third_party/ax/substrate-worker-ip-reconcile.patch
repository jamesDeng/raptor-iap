+func TestSyncer_PodIPChanged_KeepsBoundWorker(t *testing.T) {
+	ctx := context.Background()
+	ns, podName, poolName := "ns-ip-busy", "worker-ip-busy", "pool1"
+	api := newFakeControl()
+	s, pods, _ := setupReconcileTest(t, api, workerPool(ns, poolName, "gvisor", map[string]string{"workload": "ax"}))
+	key := seedPod(t, pods, workerPod(ns, podName, poolName, testPodUID, "10.0.0.7"))
+	mustReconcile(t, ctx, s, key)
+	w := api.get(testPodUID)
+	w.Status.Allocated = &ateapipb.WorkerResources{Actors: 1}
+	api.put(w)
+	changed := workerPod(ns, podName, poolName, testPodUID, "10.0.0.8")
+	if err := pods.Update(changed); err != nil {
+		t.Fatal(err)
+	}
+	fakeK8s := fake.NewSimpleClientset(changed.DeepCopy())
+	s.pods = fakeK8s.CoreV1()
+	if err := s.reconcile(ctx, key); status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("reconcile with a bound actor = %v, want FailedPrecondition", err)
+	}
+	if _, err := fakeK8s.CoreV1().Pods(ns).Get(ctx, podName, metav1.GetOptions{}); err != nil {
+		t.Errorf("pod with a bound actor was deleted: %v", err)
+	}
+	if got := api.get(testPodUID).GetStatus().GetState(); got != ateapipb.WorkerState_WORKER_STATE_ACTIVE {
+		t.Errorf("worker state = %v, want ACTIVE", got)
+	}
+	w = api.get(testPodUID)
+	w.Status.Allocated = nil
+	api.put(w)
+	mustReconcile(t, ctx, s, key)
+	if _, err := fakeK8s.CoreV1().Pods(ns).Get(ctx, podName, metav1.GetOptions{}); !apierrors.IsNotFound(err) {
+		t.Errorf("idle pod remains after retry: %v", err)
+	}
+}
