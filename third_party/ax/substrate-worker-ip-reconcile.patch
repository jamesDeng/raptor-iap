+func TestSyncer_PodIPChanged_ReplacesIdleWorker(t *testing.T) {
+	ctx := context.Background()
+	ns, podName, poolName := "ns-ip-change", "worker-ip-change", "pool1"
+	api := newFakeControl()
+	s, pods, _ := setupReconcileTest(t, api, workerPool(ns, poolName, "gvisor", map[string]string{"workload": "ax"}))
+	oldPod := workerPod(ns, podName, poolName, testPodUID, "10.0.0.7")
+	oldPod.Status.ContainerStatuses = []corev1.ContainerStatus{{Name: ateomContainer}}
+	key := seedPod(t, pods, oldPod)
+	mustReconcile(t, ctx, s, key)
+
+	changed := workerPod(ns, podName, poolName, testPodUID, "10.0.0.8")
+	changed.Status.ContainerStatuses = []corev1.ContainerStatus{{Name: ateomContainer, RestartCount: 1}}
+	if err := pods.Update(changed); err != nil {
+		t.Fatal(err)
+	}
+	// The fake Kubernetes client records the actual deletion and its UID guard.
+	fakeK8s := fake.NewSimpleClientset(changed.DeepCopy())
+	s.pods = fakeK8s.CoreV1()
+	mustReconcile(t, ctx, s, key)
+	if _, err := fakeK8s.CoreV1().Pods(ns).Get(ctx, podName, metav1.GetOptions{}); !apierrors.IsNotFound(err) {
+		t.Errorf("old pod remains after IP change: %v", err)
+	}
+	if got := api.get(testPodUID).GetStatus().GetState(); got != ateapipb.WorkerState_WORKER_STATE_DRAINING {
+		t.Errorf("worker state = %v, want DRAINING", got)
+	}
+	var deleted *metav1.Preconditions
+	for _, action := range fakeK8s.Actions() {
+		if d, ok := action.(k8stesting.DeleteAction); ok {
+			deleted = d.GetDeleteOptions().Preconditions
+		}
+	}
+	if deleted == nil || deleted.UID == nil || *deleted.UID != testPodUID {
+		t.Errorf("pod deletion preconditions = %+v, want UID %s", deleted, testPodUID)
+	}
+
+	if err := pods.Delete(changed); err != nil {
+		t.Fatal(err)
+	}
+	mustReconcile(t, ctx, s, key)
+	newPod := workerPod(ns, podName, poolName, otherPodUID, "10.0.0.8")
+	newKey := seedPod(t, pods, newPod)
+	mustReconcile(t, ctx, s, newKey)
+	if names := api.names(); len(names) != 1 || names[0] != otherPodUID {
+		t.Errorf("registered workers = %v, want replacement UID", names)
+	}
+	if got := api.get(otherPodUID).GetIps(); !slices.Equal(got, []string{"10.0.0.8"}) {
+		t.Errorf("replacement IPs = %v, want 10.0.0.8", got)
+	}
+}
